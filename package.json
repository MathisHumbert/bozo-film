{
  "name": "bozo-film",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:sanity": "sanity dev",
    "dev:all": "concurrently -n site,studio -c cyan,magenta \"npm run dev\" \"npm run dev:sanity\"",
    "build": "astro build",
    "build:sanity": "sanity build",
    "deploy:sanity": "sanity deploy",
    "astro": "astro",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "typegen:watch": "sanity typegen generate --watch",
    "check:storage": "node scripts/check-storage.mjs",
    "check:media": "node scripts/check-media-api.mjs",
    "media:cache-control": "node scripts/set-cache-control.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@blossom-carousel/core": "^1.1.8",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.26.2",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.0.3",
    "@sanity/webhook": "^4.0.4",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.11",
    "@swup/scripts-plugin": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.1",
    "astro-portabletext": "^0.13.0",
    "fontfaceobserver": "^2.3.0",
    "gsap": "^3.15.0",
    "imagesloaded": "^5.0.0",
    "lenis": "^1.3.17",
    "locomotive-scroll": "^5.0.1",
    "mediabunny": "^1.61.3",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "sanity": "^6.9.2",
    "sanity-plugin-media": "^6.1.3",
    "styled-components": "^6.5.2",
    "swup": "^4.9.2",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@sanity/visual-editing": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/imagesloaded": "^4.1.7",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
