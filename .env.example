# Copy to .env and fill in. Keep comments on their own line:
# a trailing comment after a value can swallow the next line in Vite's parser.

# ---------------------------------------------------------------------------
# Required — the site will not start without these
# ---------------------------------------------------------------------------

# sanity.io/manage → your project → Project ID
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Visual Editing — needed for the Presentation tool and draft previews
# ---------------------------------------------------------------------------

PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true

# Required whenever the flag above is true.
# sanity.io/manage → API → Tokens → add token, Viewer role
SANITY_API_READ_TOKEN=

# Drives Presentation's preview URL and the video library's API base path.
PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — ISR revalidation on Vercel
# Leave empty locally: pages simply are not cached.
# ---------------------------------------------------------------------------

# Must match the secret on the Sanity webhook. openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# The ISR purge key. Read at build time, so it must exist in Vercel's build env.
VERCEL_BYPASS_TOKEN=

# ---------------------------------------------------------------------------
# Optional — video library
# Leave empty and the Videos tool loads but cannot upload.
# ---------------------------------------------------------------------------

# s3 or r2
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_PREFIX=videos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AWS only
STORAGE_REGION=eu-west-3

# Cloudflare R2 only
R2_ACCOUNT_ID=

# The origin videos are served from: the CloudFront or R2 public domain.
PUBLIC_CDN_URL=

# ---------------------------------------------------------------------------
# Optional — only when a Studio is served outside /admin
# Comma-separated origins allowed to call /api/media/*. Empty = same-origin only.
# ---------------------------------------------------------------------------

STUDIO_ORIGINS=
