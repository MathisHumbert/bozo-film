---
import type { AboutQueryResult } from "../../../sanity/sanity.types";
import SanityImage from "../sanity-image.astro";

interface Props {
  images?: NonNullable<AboutQueryResult>["images"];
}

const images = Astro.props.images ?? [];
---

<c-about-gallery
  class="sticky top-[calc(50svh-var(--h)/2)] block h-fit [--h:calc((4*(var(--grid-column-width)+var(--grid-gutter))-var(--grid-gutter))*1.25)] md:[--h:calc((2*(var(--grid-column-width)+var(--grid-gutter))-var(--grid-gutter))*1.25)]"
>
  <div
    class="w-col-4 md:w-col-2 relative aspect-[0.8] min-h-0 overflow-clip bg-black"
  >
    {
      images.map((image, index) => (
        <div
          data-about-gallery="image"
          data-shown={index === 0 ? "" : undefined}
          class="absolute inset-0 opacity-0 transition-opacity duration-150 data-shown:opacity-100"
        >
          <SanityImage
            image={image}
            width={1000}
            loading={index < 2 ? "eager" : "lazy"}
            class="size-full object-cover"
          />
        </div>
      ))
    }
  </div>
</c-about-gallery>

<script>
  import("./about-gallery");
</script>
