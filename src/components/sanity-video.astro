---
import { stegaClean } from "@sanity/client/stega";

import type { VideoAsset } from "../lib/sanity/types";
import { videoSources } from "../lib/video-library/sources";

interface Props {
  asset?: VideoAsset | null;
  autoplay?: boolean | null;
  loop?: boolean | null;
  controls?: boolean | null;
  quality?: string;
  class?: string;
  wrapperClass?: string;
}

const {
  asset,
  autoplay,
  loop,
  controls,
  quality = "1920",
  class: className,
  wrapperClass,
} = Astro.props;

const sources = asset
  ? videoSources(
      {
        storageKey: stegaClean(asset.storageKey),
        width: asset.width,
        renditions: stegaClean(asset.renditions),
      },
      stegaClean(quality),
    )
  : [];

const poster = autoplay
  ? (stegaClean(asset?.posterLqip) ?? stegaClean(asset?.poster))
  : stegaClean(asset?.poster);

const hasIntrinsicSize = Boolean(asset?.width && asset?.height);
const aspectRatio = asset?.aspectRatio ?? 16 / 9;
---

{
  asset && sources.length > 0 && (
    <c-video
      class:list={["block", wrapperClass]}
      data-autoplay={autoplay ? "" : undefined}
      data-scroll
      data-scroll-repeat
      data-scroll-call="video:inview"
    >
      <video
        class={className}
        style={hasIntrinsicSize ? undefined : `aspect-ratio: ${aspectRatio}`}
        poster={poster ?? undefined}
        width={asset.width ?? undefined}
        height={asset.height ?? undefined}
        preload="none"
        playsinline
        muted={Boolean(autoplay)}
        loop={Boolean(loop)}
        controls={Boolean(controls)}
        aria-label={asset.altText ?? asset.title ?? undefined}
      >
        {sources.map(({ src, media }) => (
          <source data-src={src} media={media} />
        ))}
      </video>
    </c-video>
  )
}

<script>
  import("./video/video");
</script>
