---
import { stegaClean } from "@sanity/client/stega";

import type { AllWorkQueryResult } from "../../../sanity/sanity.types";
import { hrefFor } from "../../lib/routes";
import { videoSources } from "../../lib/video-library/sources";

interface Props {
  works?: AllWorkQueryResult | null;
  featured?: string[];
}

const { featured = [] } = Astro.props;

const works = (Astro.props.works ?? []).map((work) => {
  const asset = work.previewVideo;

  return {
    ...work,
    slug: stegaClean(work.slug),
    href: hrefFor({ _type: work._type, slug: stegaClean(work.slug) }),
    sources: asset
      ? videoSources(
          {
            storageKey: stegaClean(asset.storageKey),
            width: asset.width,
            renditions: stegaClean(asset.renditions),
          },
          "1280 md:1920",
        )
      : [],
    poster: stegaClean(asset?.poster) ?? undefined,
  };
});
---

<c-home-list class="block" hidden>
  <div aria-hidden="true" class="h-svh"></div>
  <div aria-hidden="true" class="h-svh"></div>

  <div class="fixed inset-0 h-svh w-full overflow-clip">
    <section aria-labelledby="home-list-title">
      <h2 id="home-list-title" class="sr-only">All Works</h2>

      <ul
        data-home-list="list"
        class="group/list flex flex-col items-center pb-2 md:pb-4"
      >
        {
          works.map((work) => (
            <li
              data-home-list="item"
              data-slug={work.slug}
              data-featured={featured.includes(work.slug ?? "") || undefined}
              class="group"
            >
              <h3>
                <a
                  href={work.href ?? undefined}
                  data-transition="home-to-work"
                  class="text-h2 duration-base ease-sine-out reduced-motion:transition-none flex items-center gap-8 pt-2 transition-opacity md:pt-4 group-data-stacked:flex-col md:gap-24 pointer-fine:group-has-[a:hover]/list:not-hover:opacity-30"
                >
                  <span class="sr-only">{work.title}</span>

                  <span
                    data-home-list="title"
                    aria-hidden="true"
                    class="whitespace-nowrap"
                  >
                    {work.titleLeft}
                  </span>

                  <span
                    data-home-list="media"
                    aria-hidden="true"
                    class="flex w-0 shrink-0 items-center justify-center group-data-stacked:h-0 group-data-stacked:w-auto"
                  >
                    <span
                      data-home-list="video"
                      data-sources={JSON.stringify(work.sources)}
                      data-poster={work.poster}
                      data-preload={
                        work.slug === featured[0]
                          ? "video"
                          : work.slug === featured[1]
                            ? "poster"
                            : undefined
                      }
                      class="block aspect-video w-100 shrink-0 scale-0 md:w-240"
                    />
                  </span>

                  <span
                    data-home-list="title"
                    aria-hidden="true"
                    class="whitespace-nowrap"
                  >
                    {work.titleRight}
                  </span>
                </a>
              </h3>
            </li>
          ))
        }
      </ul>
    </section>

    <div
      data-home-list="gradient"
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-256 bg-linear-to-b from-black to-black/0"
    >
    </div>
  </div>
</c-home-list>

<script>
  import("./home-list");
</script>
