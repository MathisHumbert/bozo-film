---
import { stegaClean } from "@sanity/client/stega";

import type { VideoAsset } from "../../lib/sanity/types";
import { formatDuration } from "../../lib/video-library/duration";
import SanityVideo from "../sanity-video.astro";

interface Props {
  slug?: string | null;
  title?: string | null;
  titleLeft?: string | null;
  titleRight?: string | null;
  previewVideo?: VideoAsset | null;
  mainVideo?: VideoAsset | null;
}

const { slug, title, titleLeft, titleRight, previewVideo, mainVideo } =
  Astro.props;

const duration = formatDuration(mainVideo?.duration);

// The same halves as the home's title, so it breaks between them on mobile.
const left = stegaClean(titleLeft);
const right = stegaClean(titleRight);
const split = Boolean(left && right);
const spaced = stegaClean(title) === `${left} ${right}`;
---

<c-work-hero data-slug={slug} class="relative block h-svh w-full">
  <div class="absolute top-0 left-0 h-[200svh] w-full">
    <div class="sticky top-0 h-svh w-full">
      <div data-work-hero="preview" aria-hidden="true" class="cover">
        <SanityVideo
          asset={previewVideo}
          autoplay
          loop
          wrapperClass="cover"
          class="h-full w-full object-cover"
        />
      </div>

      <div
        data-work-hero="overlay"
        class="cover pointer-events-none bg-black/20"
      >
      </div>

      {
        mainVideo && (
          <div
            id="work-hero-main"
            data-work-hero="main"
            class="cover invisible opacity-0"
          >
            <SanityVideo
              asset={mainVideo}
              wrapperClass="cover"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }

      <h1
        data-work-hero="title"
        class="text-h2 bottom-grid px-grid absolute left-1/2 w-full -translate-x-1/2 text-center"
      >
        {
          split ? (
            <>
              <span class="sr-only">{title}</span>
              <span aria-hidden="true">
                <span
                  data-work-hero="half"
                  class="inline-block whitespace-nowrap"
                >
                  {titleLeft}
                </span>
                {spaced && " "}
                <span
                  data-work-hero="half"
                  class="inline-block whitespace-nowrap"
                >
                  {titleRight}
                </span>
              </span>
            </>
          ) : (
            title
          )
        }
      </h1>

      {
        duration && (
          <time
            data-work-hero="duration"
            datetime={duration.iso}
            class="text-title px-grid pointer-events-none absolute top-1/2 right-0 left-0 flex -translate-y-1/2 justify-center"
          >
            <span class="sr-only">{duration.label}</span>
            <span aria-hidden="true" class="flex w-full justify-between">
              <span class="block overflow-clip">
                <span data-work-hero="duration-line" class="block">
                  {duration.minutes}
                </span>
              </span>
              <span class="block overflow-clip text-right">
                <span data-work-hero="duration-line" class="block">
                  {duration.seconds}
                </span>
              </span>
            </span>
          </time>
        )
      }

      {
        mainVideo && (
          <button
            type="button"
            data-work-hero="toggle"
            aria-controls="work-hero-main"
            class="text-h4 absolute top-1/2 left-1/2 -translate-1/2"
          >
            <span class="block overflow-clip">
              <span data-work-hero="toggle-line" class="block">
                ( <span data-work-hero="label">WATCH</span> )
              </span>
            </span>
          </button>
        )
      }
    </div>
  </div>
</c-work-hero>

<script>
  import("./work-hero");
</script>
