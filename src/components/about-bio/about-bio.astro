---
import Illustration from "../../icons/illustration.svg";

interface Props {
  description?: string | null;
}

const { description } = Astro.props;
---

<c-about-bio
  class="px-grid flex flex-col items-center gap-32 pt-178 md:gap-48 md:pt-358"
>
  <h2 class="text-h4 uppercase">( Bio )</h2>

  <div class="relative">
    <div
      aria-hidden="true"
      data-about-bio="track"
      class="pointer-events-none absolute inset-x-0 top-120 -bottom-120"
    >
      <div
        data-about-bio="anchor"
        class="absolute inset-x-0 top-0 flex h-0 items-center justify-center will-change-transform"
      >
        <Illustration
          data-about-bio="illustration"
          class="size-100 md:size-160"
        />
      </div>
    </div>

    <p
      data-about-bio="text"
      class="text-h2 w-col-10 text-center text-[4rem] whitespace-pre-line md:text-[9.6rem]"
    >
      {description}
    </p>
  </div>
</c-about-bio>

<script>
  import("./about-bio");
</script>
