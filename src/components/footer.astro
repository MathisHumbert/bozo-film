---
import { hrefFor } from "../lib/routes";
import ArrowRight from "../icons/arrow-right.svg";
import ArrowUpRight from "../icons/arrow-up-right.svg";

interface Link {
  label: string | null;
  href: string | null;
  external: boolean;
}

interface Props {
  footer?: {
    heading?: string | null;
    copyright?: string | null;
    links?: Link[] | null;
    socials?: Link[] | null;
  } | null;
  nextPage?: { _type: string; slug: string | null } | null;
}

const { footer, nextPage } = Astro.props;

const nextHref = hrefFor(nextPage);
---

<footer class="px-grid py-64">
  <div
    data-animation="line"
    data-scroll
    class="mb-64 h-px w-full bg-current/15"
  >
  </div>

  {
    nextHref && (
      <a
        href={nextHref}
        data-animation="text"
        data-scroll
        class="text-h1 group flex items-center gap-16 pb-64"
      >
        Next page
        <ArrowRight
          aria-hidden="true"
          class="w-32 transition-transform duration-300 group-hover:translate-x-8"
        />
      </a>
    )
  }

  <div class="flex flex-col gap-40 md:flex-row md:justify-between">
    <p data-animation="text" data-scroll class="md:w-col-3 text-h3">
      {footer?.heading}
    </p>

    <div
      data-animation="slide-up"
      data-scroll
      style="--delay: 0.1s"
      class="gap-grid text-body-sm flex"
    >
      <ul class="w-col-1 space-y-8 md:text-right">
        {
          footer?.links?.map((link) => (
            <li>
              <a href={link.href} class="hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="w-col-1 space-y-8 md:text-right">
        {
          footer?.socials?.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-4 hover:underline md:flex-row-reverse"
              >
                {link.label}
                <ArrowUpRight
                  aria-hidden="true"
                  class="w-12 shrink-0 opacity-50 transition-opacity group-hover:opacity-100"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div data-animation="appear" data-scroll>
    <p class="text-body-sm mt-64">
      {footer?.copyright}
    </p>
  </div>
</footer>
