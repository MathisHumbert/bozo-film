---
import { stegaClean } from "@sanity/client/stega";

import { hrefFor } from "../../lib/routes";
import type { HomeQueryResult } from "../../../sanity/sanity.types";

type Props = {
  selectedWorks?: NonNullable<HomeQueryResult>["featuredWork"] | null;
};

const works = (Astro.props.selectedWorks ?? []).map((work) => {
  const title = stegaClean(work.title);
  const left = stegaClean(work.titleLeft);
  const right = stegaClean(work.titleRight);

  return {
    ...work,
    slug: stegaClean(work.slug),
    href: hrefFor({ _type: work._type, slug: stegaClean(work.slug) }),
    split: Boolean(left && right),
    spaced: title === `${left} ${right}`,
  };
});

const first = works[0];
---

{
  first && (
    <c-home-wide class="block">
      <h2 class="sr-only">Selected Works</h2>

      <section
        data-home-wide="section"
        class="relative"
        style={`height: ${(works.length + 1) * 100}svh`}
      >
        <div class="sticky top-0 h-svh w-full overflow-clip">
          {works.map((work, index) => (
            <article
              data-home-wide="item"
              data-slug={work.slug}
              class="pointer-events-none absolute inset-0 data-active:pointer-events-auto"
              style={`z-index: ${works.length + 1 - index}`}
            >
              <div
                data-home-wide="media"
                aria-hidden="true"
                class="absolute inset-0"
              />

              <h3
                data-home-wide="text"
                class="text-h2 absolute bottom-58 left-1/2 z-2 -translate-x-1/2 whitespace-nowrap text-white"
              >
                {work.split ? (
                  <>
                    <span class="sr-only">{work.title}</span>
                    <span aria-hidden="true">
                      <span data-home-wide="title" class="inline-block">
                        {work.titleLeft}
                      </span>
                      {work.spaced && " "}
                      <span data-home-wide="title" class="inline-block">
                        {work.titleRight}
                      </span>
                    </span>
                  </>
                ) : (
                  work.title
                )}
              </h3>

              <a
                data-home-wide="text"
                href={work.href ?? "#"}
                class="text-title absolute bottom-20 left-1/2 z-2 -translate-x-1/2 text-white underline!"
              >
                VIEW PROJECT
              </a>
            </article>
          ))}

          <article
            data-home-wide="clone"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="z-index: 1"
          >
            <div data-home-wide="clone-media" class="absolute inset-0" />

            <p
              data-home-wide="clone-text"
              class="text-h2 absolute bottom-58 left-1/2 z-2 -translate-x-1/2 whitespace-nowrap text-white"
            >
              {first.title}
            </p>

            <p
              data-home-wide="clone-text"
              class="text-title absolute bottom-20 left-1/2 z-2 -translate-x-1/2 text-white"
            >
              VIEW PROJECT
            </p>
          </article>
        </div>
      </section>
    </c-home-wide>
  )
}

<script>
  import("./home-wide");
</script>
