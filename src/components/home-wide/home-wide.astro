---
import { stegaClean } from "@sanity/client/stega";

import Underline from "../underline.astro";
import { hrefFor } from "../../lib/routes";
import { formatDuration } from "../../lib/video-library/duration";
import type { HomeQueryResult } from "../../../sanity/sanity.types";

type Props = {
  selectedWorks?: NonNullable<HomeQueryResult>["featuredWork"] | null;
};

const works = (Astro.props.selectedWorks ?? []).map((work) => {
  const title = stegaClean(work.title);
  const left = stegaClean(work.titleLeft);
  const right = stegaClean(work.titleRight);

  return {
    ...work,
    slug: stegaClean(work.slug),
    href: hrefFor({ _type: work._type, slug: stegaClean(work.slug) }),
    split: Boolean(left && right),
    spaced: title === `${left} ${right}`,
    duration: formatDuration(work.mainDuration),
  };
});

const first = works[0];

function toRoman(value: number) {
  const numerals: [number, string][] = [
    [50, "L"],
    [40, "XL"],
    [10, "X"],
    [9, "IX"],
    [5, "V"],
    [4, "IV"],
    [1, "I"],
  ];

  let rest = value;
  let roman = "";

  numerals.forEach(([amount, numeral]) => {
    while (rest >= amount) {
      roman += numeral;
      rest -= amount;
    }
  });

  return roman;
}

const indexes = [...works, first].map((_, index) =>
  toRoman((index % works.length) + 1),
);
---

{
  first && (
    <c-home-wide class="block">
      <h2 class="sr-only">Selected Works</h2>

      <section
        data-home-wide="section"
        class="relative"
        style={`height: ${(works.length + 1) * 100}svh`}
      >
        <div class="sticky top-0 h-svh w-full overflow-clip">
          <span
            aria-hidden="true"
            class="text-h4 pointer-events-none absolute top-1/2 left-1/2 -translate-1/2 whitespace-nowrap"
            style={`z-index: ${works.length + 2}`}
          >
            <span class="inline-grid">
              {indexes.map((numeral) => (
                <span
                  data-home-wide="index"
                  class="col-start-1 row-start-1 text-center"
                >
                  ( {numeral} )
                </span>
              ))}
            </span>
          </span>

          {works.map((work, index) => (
            <article
              data-home-wide="item"
              data-slug={work.slug}
              class="pointer-events-none absolute inset-0 data-active:pointer-events-auto"
              style={`z-index: ${works.length + 1 - index}`}
            >
              <div
                data-home-wide="media"
                aria-hidden="true"
                class="absolute inset-0"
              />

              {work.duration && (
                <time
                  datetime={work.duration.iso}
                  class="text-title px-grid pointer-events-none absolute top-1/2 right-0 left-0 z-2 flex -translate-y-1/2 justify-center text-white"
                >
                  <span class="sr-only">{work.duration.label}</span>
                  <span aria-hidden="true" class="flex w-full justify-between">
                    <span data-home-wide="duration">
                      {work.duration.minutes}
                    </span>
                    <span data-home-wide="duration" class="text-right">
                      {work.duration.seconds}
                    </span>
                  </span>
                </time>
              )}

              {/* Breaks only between the halves, like the list and the hero. */}
              <h3
                data-home-wide="text"
                class="text-h2 px-grid absolute right-0 bottom-40 left-0 z-2 text-center text-white md:bottom-58"
              >
                {work.split ? (
                  <>
                    <span class="sr-only">{work.title}</span>
                    <span aria-hidden="true">
                      <span
                        data-home-wide="title"
                        class="inline-block whitespace-nowrap"
                      >
                        {work.titleLeft}
                      </span>
                      {work.spaced && " "}
                      <span
                        data-home-wide="title"
                        class="inline-block whitespace-nowrap"
                      >
                        {work.titleRight}
                      </span>
                    </span>
                  </>
                ) : (
                  work.title
                )}
              </h3>

              <a
                data-home-wide="text"
                data-transition="home-to-work"
                data-animation="link"
                href={work.href ?? "#"}
                class="text-title absolute bottom-20 left-1/2 z-2 -translate-x-1/2 pb-[max(1px,0.1rem)] text-white"
              >
                <span data-home-wide="link-label" class="block">
                  VIEW PROJECT
                </span>
                <Underline />
              </a>
            </article>
          ))}

          <article
            data-home-wide="clone"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="z-index: 1"
          >
            <div data-home-wide="clone-media" class="absolute inset-0" />

            <p
              data-home-wide="clone-text"
              class="text-h2 px-grid absolute right-0 bottom-40 left-0 z-2 text-center text-white md:bottom-58"
            >
              {first.split ? (
                <>
                  <span class="inline-block whitespace-nowrap">
                    {first.titleLeft}
                  </span>
                  {first.spaced && " "}
                  <span class="inline-block whitespace-nowrap">
                    {first.titleRight}
                  </span>
                </>
              ) : (
                first.title
              )}
            </p>

            <p
              data-home-wide="clone-text"
              data-animation="link"
              class="text-title absolute bottom-20 left-1/2 z-2 -translate-x-1/2 pb-[max(1px,0.1rem)] text-white"
            >
              <span data-home-wide="link-label" class="block">
                VIEW PROJECT
              </span>
              <Underline />
            </p>

            {first.duration && (
              <p class="text-title px-grid absolute top-1/2 right-0 left-0 z-2 flex -translate-y-1/2 justify-center text-white">
                <span class="flex w-full justify-between">
                  <span data-home-wide="clone-duration">
                    {first.duration.minutes}
                  </span>
                  <span data-home-wide="clone-duration" class="text-right">
                    {first.duration.seconds}
                  </span>
                </span>
              </p>
            )}
          </article>
        </div>
      </section>
    </c-home-wide>
  )
}

<script>
  import("./home-wide");
</script>
