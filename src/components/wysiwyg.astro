---
import { PortableText } from "astro-portabletext";

import type { PageBuilderBlockOf } from "../lib/sanity/types";
import SanityImage from "./sanity-image.astro";

type Props = PageBuilderBlockOf<"wysiwyg">;

const { body } = Astro.props;

const components = {
  type: {
    image: SanityImage,
  },
};
---

{
  body && (
    <section class="px-grid py-64">
      <div class="prose md:w-col-6">
        <PortableText value={body} components={components} />
      </div>
    </section>
  )
}
