---
import { stegaClean } from "@sanity/client/stega";

import type { VideoAsset } from "../../lib/sanity/types";
import { hrefFor } from "../../lib/routes";
import { formatDuration } from "../../lib/video-library/duration";
import SanityVideo from "../sanity-video.astro";

interface Props {
  title?: string | null;
  titleLeft?: string | null;
  titleRight?: string | null;
  slug?: string | null;
  previewVideo?: VideoAsset | null;
  mainDuration?: number | null;
}

const { title, titleLeft, titleRight, slug, previewVideo, mainDuration } =
  Astro.props;

const duration = formatDuration(mainDuration);

const left = stegaClean(titleLeft);
const right = stegaClean(titleRight);
const split = Boolean(left && right);
const spaced = stegaClean(title) === `${left} ${right}`;
---

<!-- The video waits zoomed in: WorkToWork zooms it out to the next hero's
scale before handing the <video> over. A transform, not Tailwind's scale-*,
which is the separate `scale` property GSAP's scale would multiply. -->
<c-work-next class="relative block h-svh w-full overflow-clip">
  <SanityVideo
    asset={previewVideo}
    autoplay
    loop
    wrapperClass="cover [transform:scale(1.2)]"
    class="h-full w-full object-cover"
  />

  <div class="cover pointer-events-none bg-black/20"></div>

  {
    duration && (
      <time
        data-work-next="duration"
        datetime={duration.iso}
        class="text-title px-grid pointer-events-none absolute top-1/2 right-0 left-0 flex -translate-y-1/2 justify-center"
      >
        <span class="sr-only">{duration.label}</span>
        <span aria-hidden="true" class="flex w-full justify-between">
          <span>{duration.minutes}</span>
          <span class="text-right">{duration.seconds}</span>
        </span>
      </time>
    )
  }

  <a
    href={hrefFor({ _type: "work", slug })}
    data-transition="work-to-work"
    data-work-next="ui"
    class="text-h4 absolute top-1/2 left-1/2 -translate-1/2 uppercase"
  >
    <span class="block overflow-clip">
      <span data-work-next="line" class="block whitespace-nowrap">
        ( <span data-animation="split-hover">Next Project</span> )
      </span>
    </span>
  </a>

  <p
    data-work-next="title"
    class="text-h2 px-grid absolute bottom-48 left-1/2 w-full -translate-x-1/2 text-center md:bottom-58"
  >
    {
      split ? (
        <>
          <span class="sr-only">{title}</span>
          <span aria-hidden="true">
            <span class="inline-block whitespace-nowrap">{titleLeft}</span>
            {spaced && " "}
            <span class="inline-block whitespace-nowrap">{titleRight}</span>
          </span>
        </>
      ) : (
        title
      )
    }
  </p>
</c-work-next>

<script>
  import("./work-next");
</script>
