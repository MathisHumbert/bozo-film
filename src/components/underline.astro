---
// Puts the line 0.25em under the baseline at any line-height:
// 0.25em - 0.19em (descent-override) - (1lh - 1em) / 2.
---

<span
  data-link-line="first"
  aria-hidden="true"
  class="pointer-events-none absolute bottom-0 left-0 h-[max(1px,0.1rem)] w-full origin-right translate-y-[calc(0.06em-(1lh-1em)/2)] bg-current will-change-transform"
></span>
<span
  data-link-line="second"
  aria-hidden="true"
  class="pointer-events-none absolute bottom-0 left-0 h-[max(1px,0.1rem)] w-full origin-left translate-y-[calc(0.06em-(1lh-1em)/2)] bg-current will-change-transform"
  style="transform: scaleX(0)"></span>
