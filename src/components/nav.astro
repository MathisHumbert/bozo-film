---
import Modal from "./modal/modal.astro";

interface Link {
  label: string | null;
  href: string | null;
  external: boolean;
}

interface Props {
  links?: Link[] | null;
}

const { links } = Astro.props;

import Logo from "../icons/logo.svg";
---

<c-nav class="contents">
  <header
    data-nav
    class="p-grid z-navigation text-title pointer-events-none fixed top-0 right-0 left-0 uppercase"
  >
    <nav class="grid grid-cols-3">
      <ul class="flex gap-24">
        <li class="pointer-events-auto hidden md:block">
          <a href="/" data-transition="work-to-home"
            >Film
            <!-- afficher nombre de projet -->
            <span class="relative top-[-0.5em] ml-4 text-[0.6em] leading-none"
              >12</span
            >
          </a>
        </li>
        <li class="pointer-events-auto hidden md:block">
          <a href="/photo"
            >Photo
            <span class="relative top-[-0.5em] ml-4 text-[0.6em] leading-none"
              >8</span
            >
          </a>
        </li>
        <li class="pointer-events-auto md:hidden">
          <button
            data-modal-open="menu"
            type="button"
            class="text-title uppercase">Menu</button
          >
        </li>
      </ul>

      <a
        href="/"
        data-transition="work-to-home"
        class="pointer-events-auto flex justify-center"
      >
        <span class="sr-only">Bozo Logo</span>
        <Logo class="h-auto w-112 md:w-240" aria-hidden="true" />
      </a>

      <ul class="flex justify-end gap-24">
        <li>
          <a href="/about" class="pointer-events-auto hidden md:block">Bio</a>
        </li>
        <li>
          <!-- use about email -->
          <a href="" class="pointer-events-auto">Contact</a>
        </li>
      </ul>
    </nav>
  </header>
</c-nav>

<Modal name="menu" labelledby="menu-title">
  <div
    class="p-grid flex min-h-dvh flex-col justify-between bg-white text-black"
  >
    <div class="grid grid-cols-3">
      <div>
        <button data-modal-close type="button" class="text-title uppercase"
          >Close</button
        >
      </div>
      <a
        href="/"
        data-transition="work-to-home"
        class="pointer-events-auto flex justify-center"
      >
        <span class="sr-only">Bozo Logo</span>
        <Logo class="h-auto w-112" aria-hidden="true" />
      </a>
      <div></div>
    </div>

    <nav
      aria-label="Menu"
      class="flex shrink-0 flex-col items-center justify-center text-center"
    >
      <ul class="text-h2 flex flex-col gap-8">
        <li><a href="/">Film</a></li>
        <li><a href="/photo">Photo</a></li>
        <li><a href="/about">Bio</a></li>
      </ul>
    </nav>

    <a
      href="mailto:info@bozofilm.com"
      class="text-title mx-auto uppercase underline">info@bozofilm.com</a
    >
  </div>
</Modal>

<script>
  import("./nav");
</script>
