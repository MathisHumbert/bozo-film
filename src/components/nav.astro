---
import Modal from "./modal/modal.astro";

interface Link {
  label: string | null;
  href: string | null;
  external: boolean;
}

interface Props {
  links?: Link[] | null;
}

const { links } = Astro.props;

import Logo from "../icons/logo.svg";
---

<header
  data-nav
  class="p-grid z-navigation text-title pointer-events-none fixed top-0 right-0 left-0"
>
  <nav class="grid grid-cols-3">
    <ul class="flex gap-24">
      <li>
        <a href="/" class="pointer-events-auto hidden sm:block"
          >Film
          <!-- afficher nombre de projet -->
          <span>(12)</span>
        </a>
      </li>
      <li>
        <a href="/photo" class="pointer-events-auto hidden sm:block"
          >Photo
          <span>(8)</span>
        </a>
      </li>
      <li>
        <button type="button" class="pointer-events-auto sm:hidden"
          >Menu
        </button>
      </li>
    </ul>

    <a href="/" class="pointer-events-auto flex justify-center">
      <span class="sr-only">Bozo Logo</span>
      <Logo class="h-auto w-112 sm:w-240" aria-hidden="true" />
    </a>

    <ul class="flex justify-end gap-24">
      <li>
        <a href="/about" class="pointer-events-auto hidden sm:block">Bio</a>
      </li>
      <li>
        <!-- use about email -->
        <a href="" class="pointer-events-auto">Contact</a>
      </li>
    </ul>
  </nav>
</header>

<Modal name="menu" labelledby="menu-title">
  <div class="min-h-dvh bg-white text-black">
    <div class="p-grid sticky top-0 flex items-start justify-between bg-black">
      <h2 id="menu-title" class="text-label uppercase">Menu</h2>

      <button type="button" data-modal-close class="text-label uppercase">
        Close
      </button>
    </div>

    <nav aria-label="Menu" class="px-grid pb-96">
      <ul class="flex flex-col gap-8">
        {
          links?.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                data-modal-close
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Modal>
