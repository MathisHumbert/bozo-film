---
export const prerender = false;

import { loadQuery } from "../lib/sanity/load-query";
import { homeQuery } from "../lib/sanity/queries";
import Layout from "../layouts/layout.astro";
import PageBuilder from "../components/page-builder.astro";
import ArrowUpRight from "../icons/arrow-up-right.svg";

const home = await loadQuery(homeQuery);

const blocks = (home?.content ?? []).filter(
  (block) => block._type === "video" || block._type === "wysiwyg",
);

const isEmpty = blocks.length === 0;

const links = [
  { label: "Open the Studio", href: "/admin", external: false },
  { label: "README", href: "https://docs.astro.build", external: true },
];
---

<Layout
  seo={home?.seo}
  settings={home?.settings}
  page={{ type: "home" }}
  updatedAt={home?._updatedAt}
>
  {
    isEmpty ? (
      <section class="px-grid flex min-h-dvh flex-col justify-center">
        <p
          data-animation="text"
          data-scroll
          class="text-label uppercase opacity-50"
        >
          Astro + Sanity
        </p>

        <h1
          data-animation="text"
          data-scroll
          class="text-display max-w-col-8 mt-16"
        >
          Creative boilerplate
        </h1>

        <p
          data-animation="slide-up"
          data-scroll
          style="--delay: 0.1s"
          class="text-body max-w-col-4 mt-32 opacity-70"
        >
          The dataset is empty. Open the Studio, add blocks to the Home
          document, and they render here through the page builder.
        </p>

        <ul
          data-animation="slide-up"
          data-scroll
          style="--delay: 0.2s"
          class="text-body-sm mt-48 flex flex-wrap gap-24"
        >
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group inline-flex items-center gap-8 underline underline-offset-4"
              >
                {link.label}
                <ArrowUpRight
                  aria-hidden="true"
                  class="w-12 transition-transform group-hover:-translate-y-2"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <PageBuilder content={blocks} />
    )
  }
</Layout>
