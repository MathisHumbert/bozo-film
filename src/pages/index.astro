---
export const prerender = false;

import { loadQuery } from "../lib/sanity/load-query";
import { allWorkQuery, homeQuery } from "../lib/sanity/queries";
import Layout from "../layouts/layout.astro";

import HomeWide from "../components/home-wide/home-wide.astro";
import HomeList from "../components/home-list/home-list.astro";
import HomeFooter from "../components/home-footer/home-footer.astro";

const home = await loadQuery(homeQuery);
const allWork = await loadQuery(allWorkQuery);

const selectedWorks = home?.featuredWork ?? [];
const works = allWork ?? [];
---

<Layout
  seo={home?.seo}
  page={{ type: "home" }}
  updatedAt={home?._updatedAt}
  background="#000000"
  color="#FFFFFF"
  infiniteScroll
>
  <h1 class="sr-only">{home?.title ?? "Home"}</h1>

  <div data-home-view="wide">
    <HomeWide selectedWorks={selectedWorks} />
  </div>

  <div data-home-view="list" hidden>
    <HomeList works={works} />
  </div>

  <HomeFooter />
</Layout>
