---
export const prerender = false;

import { stegaClean } from "@sanity/client/stega";
import { loadQuery } from "../lib/sanity/load-query";
import { aboutQuery } from "../lib/sanity/queries";
import Layout from "../layouts/layout.astro";
import Year from "../components/year/year.astro";
import AboutBio from "../components/about-bio/about-bio.astro";
import AboutReel from "../components/about-reel/about-reel.astro";
import Underline from "../components/underline.astro";

const about = await loadQuery(aboutQuery, {}, { cookies: Astro.cookies });

const email = stegaClean(about?.contact?.email);
const phone = stegaClean(about?.contact?.phone);
---

<Layout
  seo={about?.seo}
  page={{ type: "about" }}
  updatedAt={about?._updatedAt}
  background="#f7ff60"
  color="#000000"
>
  <h1 class="sr-only">{about?.title ?? "About"}</h1>

  <AboutBio description={about?.description} />

  <section
    class="px-grid gap-gutter relative grid grid-cols-2 pt-192 md:pt-240"
  >
    <div class="sticky top-[calc(var(--grid-margin)*3)] h-fit">
      <div class="w-col-4 md:w-col-2 aspect-[0.8] bg-black"></div>
    </div>

    <div class="flex flex-col gap-48 md:gap-96">
      <div class="md:gap-gutter grid grid-cols-1 gap-48 md:grid-cols-2">
        <div class="flex flex-col gap-24 md:gap-32">
          <h2 class="text-title uppercase">Services</h2>
          <ul class="flex flex-col gap-4 md:gap-8">
            {
              about?.services?.map((service) => (
                <li class="text-h4">{service}</li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-24 md:gap-32">
          <h2 class="text-title uppercase">Select Clients</h2>
          <ul class="flex flex-col gap-4 md:gap-8">
            {about?.clients?.map((client) => <li class="text-h4">{client}</li>)}
          </ul>
        </div>
      </div>

      {
        about?.socialLinks?.length ? (
          <div class="flex flex-col gap-24 md:gap-32">
            <h2 class="text-title uppercase">Follow me</h2>

            <ul class="flex flex-col gap-4 md:gap-8">
              {about.socialLinks.map((link) => (
                <li class="text-h4">
                  <a
                    href={link.href ?? undefined}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    data-animation="link"
                    class="relative pb-[max(1px,0.1rem)]"
                  >
                    {link.label}
                    <Underline />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        (email || phone) && (
          <div class="text-h4 flex flex-col gap-4 md:gap-8">
            {email && (
              <a
                href={`mailto:${email}`}
                data-animation="link"
                class="relative w-fit pb-[max(1px,0.1rem)]"
              >
                {email}
                <Underline />
              </a>
            )}
            {phone && (
              <a
                href={`tel:${phone.replace(/[^\d+]/g, "")}`}
                data-animation="link"
                class="relative w-fit pb-[max(1px,0.1rem)]"
              >
                {phone}
                <Underline />
              </a>
            )}
          </div>
        )
      }
    </div>
  </section>

  <section
    class="text-h1 px-grid flex flex-col items-center gap-48 py-160 text-center md:gap-64 md:py-240"
  >
    <h2 class="sr-only">Showreel</h2>

    <p style="white-space: pre-line" class="">{about?.reel?.textTop}</p>

    <AboutReel preview={about?.reel?.preview} main={about?.reel?.main} />

    <p style="white-space: pre-line">{about?.reel?.textBottom}</p>
  </section>

  <section
    class="text-title p-grid grid grid-cols-2 gap-y-8 pt-0 uppercase md:grid-cols-3"
  >
    <span>© Copyright BOZO FILM.</span>
    <span
      class="order-first col-span-2 flex justify-center md:order-0 md:col-span-1"
      ><Year format="roman" /></span
    >
    <span class="flex justify-end">All rights reserved</span>
  </section>
</Layout>
