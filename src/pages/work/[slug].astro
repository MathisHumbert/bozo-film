---
export const prerender = false;

import { loadQuery } from "../../lib/sanity/load-query";
import { allWorkQuery, workBySlugQuery } from "../../lib/sanity/queries";
import Layout from "../../layouts/layout.astro";
import SanityVideo from "../../components/sanity-video.astro";
import SanityImage from "../../components/sanity-image.astro";
import WorkHero from "../../components/work-hero/work-hero.astro";
import WorkNext from "../../components/work-next/work-next.astro";

const { slug } = Astro.params;

const work = await loadQuery(
  workBySlugQuery,
  { slug },
  { cookies: Astro.cookies },
);

if (!work) {
  return new Response(null, { status: 404 });
}

const allWork =
  (await loadQuery(allWorkQuery, {}, { cookies: Astro.cookies })) ?? [];
const currentIndex = allWork.findIndex((item) => item.slug === slug);
const next =
  currentIndex !== -1 && allWork.length > 1
    ? allWork[(currentIndex + 1) % allWork.length]
    : null;

function widthFor(media?: { width?: number | null; height?: number | null }) {
  const ratio = (media?.width ?? 16) / (media?.height ?? 9);

  if (ratio >= 1.6) {
    return "w-col-10";
  }
  if (ratio >= 1.2) {
    return "w-col-8";
  }
  if (ratio >= 0.9) {
    return "w-col-6";
  }
  if (ratio >= 0.5) {
    return "w-col-4";
  }
  {
    return "w-col-2";
  }
}
---

<Layout
  seo={work.seo}
  page={{ type: "work" }}
  updatedAt={work._updatedAt}
  background="#000000"
  color="#FFFFFF"
>
  <WorkHero
    slug={slug}
    title={work.title}
    titleLeft={work.titleLeft}
    titleRight={work.titleRight}
    previewVideo={work.previewVideo}
    mainVideo={work.mainVideo}
  />

  <div class="z-above relative bg-black">
    <section class="px-grid flex justify-center py-96 text-center md:py-128">
      <h2 class="sr-only">Project Details</h2>
      <div class="md:w-col-4 flex flex-col items-center gap-56 md:gap-64">
        <div class="flex flex-col gap-24 md:gap-32">
          <span class="text-title uppercase">Project</span>
          <h3 class="text-h3">{work.project}</h3>
        </div>

        {
          work.excerpt && (
            <p class="text-body first-letter:text-initial">{work.excerpt}</p>
          )
        }

        {
          work.category && work.category.length > 0 && (
            <div class="flex flex-col gap-24 md:gap-32">
              <h3 class="text-title uppercase">Category</h3>
              <ul class="text-h4 flex flex-col gap-8">
                {work.category?.map((category) => (
                  <li>{category}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          work.roles && work.roles.length > 0 && (
            <div class="flex flex-col gap-24 md:gap-32">
              <h3 class="text-title uppercase">Roles</h3>
              <ul class="text-h4 flex flex-col gap-8">
                {work.roles?.map((role) => (
                  <li>{role}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    {
      work.media && work.media.length > 0 && (
        <section class="flex flex-col items-center gap-16 py-64 md:gap-32 md:py-96">
          <h2 class="sr-only">List of Media</h2>

          {work.media?.map((item) =>
            item._type === "image" ? (
              <SanityImage
                image={item}
                class:list={["h-auto", widthFor(item)]}
              />
            ) : (
              <SanityVideo
                asset={item.asset}
                autoplay={item.autoplay}
                loop={item.loop}
                controls={item.controls}
                class:list={["h-auto", widthFor(item.asset)]}
              />
            ),
          )}
        </section>
      )
    }

    {
      next && (
        <WorkNext
          title={next.title}
          titleLeft={next.titleLeft}
          titleRight={next.titleRight}
          slug={next.slug}
          previewVideo={next.previewVideo}
          mainDuration={next.mainDuration}
        />
      )
    }
  </div>
</Layout>
