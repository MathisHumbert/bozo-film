---
export const prerender = false;

import { loadQuery } from "../../lib/sanity/load-query";
import { allWorkQuery, workBySlugQuery } from "../../lib/sanity/queries";
import Layout from "../../layouts/layout.astro";
import SanityVideo from "../../components/sanity-video.astro";
import SanityImage from "../../components/sanity-image.astro";
import WorkHero from "../../components/work-hero/work-hero.astro";
import WorkNext from "../../components/work-next/work-next.astro";

const { slug } = Astro.params;

const work = await loadQuery(workBySlugQuery, { slug });

if (!work) {
  return new Response(null, { status: 404 });
}

const allWork = (await loadQuery(allWorkQuery)) ?? [];
const currentIndex = allWork.findIndex((item) => item.slug === slug);
const next =
  currentIndex !== -1 && allWork.length > 1
    ? allWork[(currentIndex + 1) % allWork.length]
    : null;

function widthFor(media?: { width?: number | null; height?: number | null }) {
  const ratio = (media?.width ?? 16) / (media?.height ?? 9);

  if (ratio >= 1.6) {
    return "w-col-10";
  }
  if (ratio >= 1.2) {
    return "w-col-8";
  }
  if (ratio >= 0.9) {
    return "w-col-6";
  }
  if (ratio >= 0.5) {
    return "w-col-4";
  }
  {
    return "w-col-2";
  }
}
---

<Layout
  seo={work.seo}
  page={{ type: "work" }}
  updatedAt={work._updatedAt}
  background="#000000"
  color="#FFFFFF"
>
  <WorkHero
    title={work.title}
    previewVideo={work.previewVideo}
    mainVideo={work.mainVideo}
  />

  <div class="z-above relative bg-black">
    <section class="flex justify-center py-128 text-center">
      <div class="w-col-4 flex flex-col items-center gap-64">
        <div class="flex flex-col gap-32">
          <span class="text-title uppercase">Project</span>
          <h2 class="text-h3">{work.title}</h2>
        </div>

        <p class="text-body first-letter:text-initial">{work.excerpt}</p>

        <div class="flex flex-col gap-32">
          <h2 class="text-title uppercase">Category</h2>
          <ul class="text-h4 flex flex-col gap-8">
            {work.category?.map((category) => <li>{category}</li>)}
          </ul>
        </div>

        <div class="flex flex-col gap-32">
          <h2 class="text-title uppercase">Roles</h2>
          <ul class="text-h4 flex flex-col gap-8">
            {work.roles?.map((role) => <li>{role}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="flex flex-col items-center gap-32 py-96">
      {
        work.media?.map((item) =>
          item._type === "image" ? (
            <SanityImage image={item} class:list={["h-auto", widthFor(item)]} />
          ) : (
            <SanityVideo
              asset={item.asset}
              autoplay={item.autoplay}
              loop={item.loop}
              controls={item.controls}
              class:list={["h-auto", widthFor(item.asset)]}
            />
          ),
        )
      }
    </section>
  </div>

  {
    next && (
      <WorkNext
        title={next.title}
        slug={next.slug}
        previewVideo={next.previewVideo}
      />
    )
  }
</Layout>
